# Secret loading
#
# Any secret below can be loaded from a managed secret store instead of being
# placed here in plaintext. For a secret NAME, set NAME_CMD to a command whose
# stdout is the value; it runs once at startup. Examples:
#   SUI_PRIVATE_KEY_CMD=op read "op://Ledger/sui/private-key"
#   SUI_PRIVATE_KEY_CMD=aws secretsmanager get-secret-value --secret-id ledger/sui-key --query SecretString --output text
#   LEDGER_DATA_ENCRYPTION_KEY_CMD=vault kv get -field=key secret/ledger/data-key
# Secrets supporting _CMD include: SUI_PRIVATE_KEY, SUI_RPC_API_KEY,
# PHOTON_PROJECT_SECRET, MEMWAL_PRIVATE_KEY, LEDGER_LLM_API_KEY, BANKR_LLM_KEY,
# OPENAI_API_KEY, LEDGER_AGENT_AUTH_TOKEN, LEDGER_DATA_ENCRYPTION_KEY,
# LEDGER_LEGACY_DATA_KEY, LEDGER_VERIFY_AUTH_TOKEN, and LEDGER_ALERT_WEBHOOK_TOKEN.
# If NAME_CMD is unset, the plain NAME value is used.

# Photon Spectrum-TS
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Sui (testnet)
SUI_PRIVATE_KEY=           # bech32 private key (suiprivkey1...)
SUI_OWNER_ADDRESS=         # owner address that receives LedgerRecord objects
LEDGER_PACKAGE_ID=0x8a414cb0ccbfccf872b21c1edbe571434dd7fea7d49023d8d7a27f5ca0959f5e
SUI_NETWORK=testnet        # testnet | mainnet
SUI_RPC_URL=               # optional custom RPC endpoint (e.g. https://sui-testnet.gateway.tatum.io)
SUI_RPC_API_KEY=           # optional API key sent as x-api-key header for custom RPC
SUI_RPC_FALLBACK_URL=      # optional failover RPC; defaults to public Sui fullnode for the network

# Walrus
WALRUS_EPOCHS=3            # how many epochs to store blobs
WALRUS_PROVIDER=sdk        # sdk | cli
WALRUS_BINARY_PATH=walrus  # set to full path if walrus is not on PATH
WALRUS_CONTEXT=testnet
WALRUS_SDK_TIMEOUT_MS=60000
WALRUS_UPLOAD_RELAY_URL=  # optional, e.g. https://upload-relay.testnet.walrus.space
WALRUS_UPLOAD_RELAY_TIP_MAX_MIST= # optional max relay tip in MIST
WALRUS_SDK_LOG_NODE_ERRORS=false

# Financial memory — MemWal (Walrus Memory)
# Optional. When set, records and agent decisions are remembered on Walrus and
# recallable semantically (vendor history, spend patterns, duplicate detection).
# Unset = no-op memory; the rest of Bound still works. Create a delegate key at
# https://memory.walrus.xyz/setup. MEMWAL_PRIVATE_KEY supports the _CMD secret indirection.
MEMWAL_PRIVATE_KEY=         # delegate / SDK key from the MemWal dashboard
MEMWAL_ACCOUNT_ID=          # your MemWal account id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz   # default relayer; override if self-hosting
MEMWAL_NAMESPACE=bound      # logical namespace for these memories

# LLM (parsing pipeline)
# Works with OpenAI or any OpenAI-compatible gateway (chat/completions + json_object),
# including the Bankr LLM Gateway (self-funding compute paid by token fees).
LEDGER_LLM_PARSER=false    # true enables structured LLM parser with deterministic fallback
#
# OpenAI (default provider):
OPENAI_API_KEY=
OPENAI_PARSER_MODEL=gpt-4o-mini
#
# Bankr LLM Gateway (set these to route through llm.bankr.bot instead of OpenAI):
#   LEDGER_LLM_BASE_URL=https://llm.bankr.bot/v1
#   LEDGER_LLM_API_KEY=bk_usr_...      # or BANKR_LLM_KEY
#   LEDGER_LLM_MODEL=deepseek-v3.2     # cheap/fast; or claude-sonnet-4-6 for quality
# Key resolution order: LEDGER_LLM_API_KEY -> BANKR_LLM_KEY -> OPENAI_API_KEY.
# Base URL order: LEDGER_LLM_BASE_URL -> BANKR_LLM_BASE_URL -> https://api.openai.com/v1.
# All keys above also support the _CMD secret-store indirection.

# App
LEDGER_BASE_URL=https://ledger.app
LEDGER_VERIFY_PORT=8787
LEDGER_VERIFY_AUTH_TOKEN= # optional bearer token for /verify/:objectId
LEDGER_VERIFY_SMOKE_BASE_URL= # deployed verify origin for npm run smoke:verify-http; defaults to LEDGER_BASE_URL
LEDGER_VERIFY_SMOKE_OBJECT_ID= # known live LedgerRecord object used by npm run smoke:verify-http
LEDGER_VERIFY_RATE_LIMIT_MAX=60
LEDGER_VERIFY_RATE_LIMIT_WINDOW_MS=60000

# Agent API (programmatic access for AI agents; npm run start:agent-api)
LEDGER_AGENT_PORT=8788
LEDGER_AGENT_AUTH_TOKEN=   # REQUIRED to run the agent API (it executes payments); supports _CMD
LEDGER_AGENT_RATE_LIMIT_MAX=    # optional per-client request cap; unset disables limiting
LEDGER_AGENT_RATE_LIMIT_WINDOW_MS=60000

# MCP server (npm run start:mcp)
LEDGER_MCP_MODE=agent      # agent (safe: propose+read only) | owner (full admin surface)
LEDGER_MCP_AGENT_ID=       # agent mode: pin the agent identity so it can't impersonate another policy
LEDGER_MCP_MIN_PROPOSAL_INTERVAL_MS=0  # agent mode: min ms between gas-costing proposals (0 = off)
LEDGER_DB_PATH=            # optional; defaults to ./ledger.db
LEDGER_MOCK=false          # true only for local tests, never production
LEDGER_USE_V2_MINT=true    # v2 package is required for actor metadata
LEDGER_ENABLE_PAYMENTS=false # true allows approved agent SUI transfers
LEDGER_MIN_SUI_BALANCE_MIST=50000000 # reserve after SUI payments and estimated gas
LEDGER_AGENT_SPEND_WINDOW_MS=86400000 # rolling policy spend window, default 24h
LEDGER_ALERT_WEBHOOK_URL=  # optional JSON webhook for error-level alerts
LEDGER_ALERT_WEBHOOK_TOKEN= # optional bearer token for alert webhook

# Payload encryption
LEDGER_DATA_KEY_ID=        # active data key id, e.g. dek-2026-06
LEDGER_DATA_ENCRYPTION_KEY= # active data encryption key material; do not reuse SUI_PRIVATE_KEY
LEDGER_LEGACY_DATA_KEY=    # optional comma-separated keyId:key entries for decrypting old dedicated keys
