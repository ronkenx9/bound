[Unit]
Description=Bound message worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bound
EnvironmentFile=/etc/bound/bound.env
ExecStartPre=/usr/bin/npm run production:check
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
User=ledger
Group=ledger
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bound

[Install]
WantedBy=multi-user.target
